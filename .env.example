# Flask Application Secret Key
SECRET_KEY=your_secret_key_here

# Microsoft SQL Server (SSMS) Connection
DB_SERVER=your_sql_server_or_localhost
DB_NAME=SentimentAI_DB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_TRUST_CERT=yes
# Optional full DATABASE_URL override:
# DATABASE_URL=mssql+pyodbc://your_sql_server_or_localhost/SentimentAI_DB?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Google Gemini AI API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
